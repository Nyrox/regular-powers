#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for one design's
# short-lived artifacts: implementer reports, review packages, and the
# progress ledger. Print the design directory's absolute path.
#
# One directory per design (.superpowers/sdd/<design-basename>/) so a
# follow-up design in the same working tree can never read or overwrite
# another design's artifacts. A stale ledger misread as current progress
# makes controllers skip whole task sequences — design-scoping removes that
# failure structurally.
#
# The workspace lives in the working tree (not under .git/) because some
# harnesses treat .git/ as a protected path and deny agent writes there —
# which blocks an implementer subagent from writing its report file. A
# self-ignoring .gitignore at .superpowers/sdd/ keeps every design's workspace
# out of `git status` and out of accidental commits without modifying any
# tracked file.
#
# Single source of truth for the workspace location, so review-package
# cannot drift to a different directory.
#
# Usage: sdd-workspace DESIGN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace DESIGN_FILE" >&2
  exit 2
fi

design=$1
[ -f "$design" ] || { echo "no such design file: $design" >&2; exit 2; }

slug=$(basename "$design" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $design" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
base="$root/.superpowers/sdd"
dir="$base/$slug"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
